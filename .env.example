# Copy to .env and fill in if you are deploying your own Worker.
# These values are not required to run the app locally (npm run dev).
#
# Cloudflare account id: Dashboard → Workers & Pages, or `npx wrangler whoami`
# CLOUDFLARE_ACCOUNT_ID=
#
# D1 database used by 同步碼 (create with `npx wrangler d1 create lingotube-sync`)
LINGOTUBE_D1_DATABASE_ID=
#
# Optional Worker script name (default: lingotube)
# LINGOTUBE_WORKER_NAME=lingotube
